{
  "name": "ec-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "node scripts/check-env.mjs",
    "test": "tsx --test tests/*.test.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:migrate-order-statuses": "tsx scripts/migrate-order-statuses.ts",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "user:role": "tsx scripts/set-user-role.ts",
    "check": "npm run env:check && npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "mongoose": "^9.9.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
